# SQLite for local dev/test. In production point this at Postgres and swap the
# driver in src/db/index.ts (see docs/ARCHITECTURE.md).
DATABASE_URL="file:./learningos.db"

# Seed credentials for the initial super-admin (src/db/seed.ts).
# If SEED_ADMIN_PASSWORD is omitted, a random one is generated and printed once.
SEED_ADMIN_EMAIL="admin@learningos.local"
SEED_ADMIN_PASSWORD="change-me-in-production"

# AI Content Engine (Phase 3.2). When set, pasted course material is drafted by
# Claude (concepts, prerequisites, difficulty, Bloom levels, objectives) for
# lecturer review. When unset, a deterministic heuristic extractor is used, so
# the workflow and tests run with no key/network.
# ANTHROPIC_API_KEY="sk-ant-..."
