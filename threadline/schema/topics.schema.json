{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadline.app/schema/topics.schema.json",
  "title": "Course micro-topics",
  "description": "An array of micro-topics for a single course. Each micro-topic is one teachable idea, small enough to map to a single 3-6 minute video.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "description",
      "type",
      "course_id",
      "module",
      "week",
      "mastery_criteria",
      "video_id",
      "video_duration_seconds"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "description": "Globally unique topic id, conventionally <course-prefix>-<nn>-<slug>.",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)+$"
      },
      "title": {
        "type": "string",
        "minLength": 3,
        "maxLength": 120
      },
      "description": {
        "type": "string",
        "description": "Plain-language explanation of the idea this topic teaches.",
        "minLength": 10
      },
      "type": {
        "type": "string",
        "enum": ["conceptual", "procedural", "representational", "language", "meta"]
      },
      "course_id": {
        "type": "string",
        "description": "Must match the id of a course in courses.json."
      },
      "module": {
        "type": "string",
        "description": "Human-readable module/unit name used to group topics in the UI."
      },
      "week": {
        "type": "integer",
        "minimum": 1,
        "maximum": 52
      },
      "mastery_criteria": {
        "type": "string",
        "description": "Observable statement of what the student can do once this topic is mastered.",
        "minLength": 10
      },
      "video_id": {
        "type": "string",
        "description": "YouTube video id (11 chars), or the literal string PLACEHOLDER until the real id is wired in.",
        "pattern": "^([A-Za-z0-9_-]{11}|PLACEHOLDER)$"
      },
      "video_duration_seconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 1200
      }
    }
  }
}
